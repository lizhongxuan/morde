[Unit]
Description=Morde host network policy
Requires=docker.service morde-network-preload.service
PartOf=docker.service morde-network-preload.service nftables.service
After=docker.service morde-network-preload.service
Before=morde-portal.service

[Service]
Type=oneshot
EnvironmentFile=/etc/cloudhost/cloudhost.env
ExecStart=/opt/cloudhost/network-policy.sh apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
