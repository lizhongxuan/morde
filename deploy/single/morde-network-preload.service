[Unit]
Description=Preload Morde host isolation before Docker restores containers
Before=docker.service
After=nftables.service
PartOf=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/cloudhost/cloudhost.env
ExecStart=/opt/cloudhost/network-policy.sh preload
ExecReload=/opt/cloudhost/network-policy.sh preload
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
