# Copy to a local env file, owned by root and mode 0600. Never commit secrets.
# Generate independent random passwords/keys; the DSN password must match PostgreSQL.
CH_POSTGRES_PASSWORD=
CH_DATABASE_DSN=
CH_OSB_URL=http://127.0.0.1:18080
CH_NETWORK_GUARD_PATH=/opt/cloudhost/network-policy.sh
CH_OSB_CONFIG_FILE=/etc/opensandbox/opensandbox.toml
CH_OSB_API_KEY=
# Directory path on the existing system filesystem; not an independent disk.
CH_POSTGRES_DATA_DIR=/srv/cloudhost-postgres
CH_DATA_KEY_FILE=/etc/cloudhost/data.key
CH_COOKIE_KEY_FILE=/etc/cloudhost/cookie.key
CH_DOCKER_HOST=unix:///var/run/docker.sock
CH_DOCKER_DATA_DIR=/var/lib/docker
# Stop new Host creation while at least 10 GiB remains on Docker's filesystem.
CH_DOCKER_MIN_FREE_BYTES=10737418240

# Dedicated persistent Workspace block store; keep separate from DockerRootDir.
CH_WORKSPACE_STORAGE_ROOT_DIR=/srv/cloudhost-workspaces
CH_WORKSPACE_MAX_BYTES=10737418240
CH_WORKSPACE_OWNER_MAX_BYTES=53687091200
CH_WORKSPACE_MIN_FREE_BYTES=10737418240

# Separate private store reserved for immutable Site release artifacts.
CH_SITE_STORAGE_ROOT_DIR=/srv/cloudhost-sites
CH_SITE_STORAGE_MAX_RELEASE_BYTES=10737418240
CH_SITE_STORAGE_MAX_OWNER_BYTES=53687091200
CH_SITE_STORAGE_MIN_FREE_BYTES=10737418240

# Isolated local/intranet HTTP only. Replace loopback with the Linux server's
# intranet IP for office clients. Portal and hosts use different registered domains.
CH_SCHEME=http
CH_PORTAL_DOMAIN=portal.127.0.0.1.sslip.io
CH_HOST_SUFFIX=127.0.0.1.nip.io
CH_COOKIE_SECURE=false
CH_CADDY_PORTAL_ADDRESS=http://portal.127.0.0.1.sslip.io
CH_CADDY_HOST_ADDRESS=http://*.127.0.0.1.nip.io
CH_CADDY_PORTAL_TLS=
CH_CADDY_HOST_TLS=

# F02 private Syncthing relay. Not started by the default Compose profile.
# When enabled, advertise a static public IPv4 literal on TCP 22067 to desktop
# clients. Bind the listener to a concrete host IPv4 reachable from Docker
# account bridges; account nodes use that private bind address to avoid NAT hairpin.
# Host nftables allows account bridges to reach only this relay endpoint.
# Loopback values below are inactive placeholders; replace them before enabling the feature.
CH_WORKSPACE_SYNC_RELAY_IMAGE=local/morde-workspace-sync-relay:unset
CH_WORKSPACE_SYNC_NODE_IMAGE_ID=
CH_WORKSPACE_SYNC_RELAY_IMAGE_ID=
CH_WORKSPACE_SYNC_RELAY_PUBLIC_ADDRESS=127.0.0.1:22067
CH_WORKSPACE_SYNC_RELAY_BIND_ADDRESS=127.0.0.1
CH_WORKSPACE_SYNC_RELAY_PORT=22067
CH_WORKSPACE_SYNC_RELAY_TOKEN=
CH_WORKSPACE_SYNC_RELAY_STATE_DIR=/srv/morde-workspace-sync-relay
CH_WORKSPACE_SYNC_NODE_STATE_DIR=/srv/morde-workspace-sync-nodes
CH_WORKSPACE_SYNC_CURRENT_FILES_DIR=/srv/morde-workspace-sync-files

CH_TEMPLATE=std-2c4g
CH_TEMPLATE_DIR=deploy/single/templates
# For public testing, replace 127.0.0.1 with the server IPv4 in both domains,
# use portal.<IPv4>.sslip.io and <IPv4>.nip.io, set CH_SCHEME=https and
# CH_COOKIE_SECURE=true and remove http:// from both Caddy addresses. Set each
# TLS value to the multiline Caddy block: tls { newline on_demand newline }.
# This temporary DNS discloses the server IP.
# CH_CADDY_PORTAL_TLS='tls {
#   on_demand
# }'
# CH_CADDY_HOST_TLS='tls {
#   on_demand
# }'
# Keep HTTP mode private; it does not provide secure cookies or trusted TLS.
