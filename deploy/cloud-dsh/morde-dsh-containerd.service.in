# TEMPLATE ONLY: install only with the matching dedicated DSH Docker service.
[Unit]
Description=Morde isolated containerd for cloud DSH agents
Before=morde-dsh-docker.service
StartLimitIntervalSec=0

[Service]
Type=notify
User=root
Group=root
ExecStart=/usr/bin/containerd --address /run/morde-dsh-containerd/containerd.sock --root /var/lib/morde-dsh-containerd --state /run/morde-dsh-containerd
Restart=on-failure
RestartSec=2s
TimeoutStopSec=1min
LimitNOFILE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
UMask=0027
RuntimeDirectory=morde-dsh-containerd
RuntimeDirectoryMode=0755
StateDirectory=morde-dsh-containerd
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
