+package generate
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/syncthing/syncthing/lib/config"
+)
+
+func TestMordeDesktopDefaultsDisablePublicNetworkingAndPreserveManagedEntries(t *testing.T) {
+	folders := []config.FolderConfiguration{{ID: "morde-0123456789abcdef0123456789abcdef"}}
+	devices := []config.DeviceConfiguration{{Name: "registered owner"}}
+	cfg := config.Configuration{
+		Folders: folders,
+		Devices: devices,
+		GUI: config.GUIConfiguration{RawAddress: "0.0.0.0:8384"},
+		Options: config.OptionsConfiguration{
+			RawListenAddresses: []string{"default"},
+			RawGlobalAnnServers: []string{"default"},
+			RawStunServers: []string{"default"},
+			GlobalAnnEnabled: true,
+			LocalAnnEnabled: true,
+			RelaysEnabled: true,
+			NATEnabled: true,
+			AnnounceLANAddresses: true,
+			CREnabled: true,
+			AutoUpgradeIntervalH: 12,
+			StartBrowser: true,
+			DeprecatedDefaultFolderPath: "/tmp/Sync",
+		},
+	}
+
+	applyMordeDesktopDefaults(&cfg)
+
+	if !reflect.DeepEqual(cfg.Folders, folders) || !reflect.DeepEqual(cfg.Devices, devices) {
+		t.Fatal("safe defaults must preserve registered folders and devices")
+	}
+	if cfg.GUI.RawAddress != "127.0.0.1:8384" || !reflect.DeepEqual(cfg.Options.RawListenAddresses, []string{""}) ||
+		len(cfg.Options.RawGlobalAnnServers) != 0 || len(cfg.Options.RawStunServers) != 0 ||
+		cfg.Options.GlobalAnnEnabled || cfg.Options.LocalAnnEnabled || cfg.Options.RelaysEnabled || cfg.Options.NATEnabled ||
+		cfg.Options.AnnounceLANAddresses || cfg.Options.CREnabled || cfg.Options.AutoUpgradeIntervalH != 0 ||
+		cfg.Options.StartBrowser || cfg.Options.DeprecatedDefaultFolderPath != "" {
+		t.Fatalf("Morde desktop networking defaults are unsafe: %+v %+v", cfg.GUI, cfg.Options)
+	}
+}
