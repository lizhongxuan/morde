+
+package model
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/syncthing/syncthing/lib/protocol"
+)
+
+var errMordeQuotaResultUnknown = errors.New("Morde quota operation result is unknown")
+var errMordeQuotaUnresolvedOperation = errors.New("another Morde quota operation has an unknown result")
+var errMordeQuotaAborted = errors.New("Morde quota reservation was aborted")
+
+const mordeQuotaResponseLimit = 16 << 10
+
+type mordeQuotaOutcome uint8
+
+const (
+	mordeQuotaUnknown mordeQuotaOutcome = iota
+	mordeQuotaComplete
+	mordeQuotaAbortedOutcome
+)
+
+type mordeQuotaClient struct {
+	workspaceID string
+	folderID    string
+	client      *http.Client
+}
+
+type mordeQuotaReservation struct {
+	ReservationID  string          `json:"reservation_id"`
+	State          string          `json:"state"`
+	BaseRevision   json.RawMessage `json:"base_revision"`
+	ResultRevision json.RawMessage `json:"result_revision,omitempty"`
+}
+
+type mordeQuotaRequest struct {
+	WorkspaceID string `json:"workspace_id"`
+	FolderID    string `json:"folder_id"`
+	OperationID string `json:"operation_id"`
+	Path        string `json:"path"`
+	Operation   string `json:"operation"`
+	SizeBytes   int64  `json:"size_bytes"`
+}
+
+type mordeQuotaSerial struct {
+	mut      sync.Mutex
+	active   string
+	activeID string
+	busy     bool
+	changed  chan struct{}
+	attempts map[string]uint64
+}
+
+func (f *sendReceiveFolder) reserveMordeFile(ctx context.Context, file protocol.FileInfo, operation string, size int64) (func(mordeQuotaOutcome), string, error) {
+	if f.mordeQuotaClient == nil {
+		return nil, "", nil
+	}
+	baseID := mordeQuotaOperationID(f.folderID, file, operation)
+	for {
+		release, operationID, err := f.mordeQuotaSerial.acquire(ctx, baseID)
+		if err != nil {
+			return nil, "", err
+		}
+		reserveCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+		reservation, err := f.mordeQuotaClient.reserve(reserveCtx, file, operation, size, operationID)
+		cancel()
+		if err != nil {
+			if errors.Is(err, errMordeQuotaResultUnknown) {
+				release(mordeQuotaUnknown)
+			} else {
+				release(mordeQuotaComplete)
+			}
+			return nil, "", err
+		}
+		switch reservation.State {
+		case "reserved", "settled":
+			return release, reservation.ReservationID, nil
+		case "aborted":
+			release(mordeQuotaAbortedOutcome)
+		case "aborting":
+			release(mordeQuotaUnknown)
+			return nil, "", mordeQuotaUnknownError("reserve", errors.New("reservation abort is still in progress"))
+		default:
+			release(mordeQuotaUnknown)
+			return nil, "", mordeQuotaUnknownError("reserve", fmt.Errorf("unexpected reservation state %q", reservation.State))
+		}
+	}
+}
+
+func newMordeQuotaClient(socketPath, workspaceID, folderID string) *mordeQuotaClient {
+	if socketPath == "" {
+		return nil
+	}
+	transport := &http.Transport{
+		Proxy: nil,
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "unix", socketPath)
+		},
+	}
+	return &mordeQuotaClient{
+		workspaceID: workspaceID, folderID: folderID,
+		client: &http.Client{
+			Transport: transport,
+			CheckRedirect: func(*http.Request, []*http.Request) error {
+				return http.ErrUseLastResponse
+			},
+		},
+	}
+}
+
+// acquire serializes Workspace mutations. Unknown results keep the same attempt
+// ID; a confirmed abort advances the deterministic attempt ID for the next try.
+func (s *mordeQuotaSerial) acquire(ctx context.Context, baseID string) (func(mordeQuotaOutcome), string, error) {
+	for {
+		s.mut.Lock()
+		if s.changed == nil {
+			s.changed = make(chan struct{})
+		}
+		if s.attempts == nil {
+			s.attempts = make(map[string]uint64)
+		}
+		operationID := mordeQuotaAttemptID(baseID, s.attempts[baseID])
+		if s.active == "" {
+			s.active = baseID
+			s.activeID = operationID
+		}
+		if s.active == baseID && s.activeID == operationID && !s.busy {
+			s.busy = true
+			s.mut.Unlock()
+			var once sync.Once
+			return func(outcome mordeQuotaOutcome) {
+				once.Do(func() {
+					s.mut.Lock()
+					s.busy = false
+					if outcome == mordeQuotaAbortedOutcome {
+						s.attempts[baseID]++
+					}
+					if outcome != mordeQuotaUnknown && s.active == baseID && s.activeID == operationID {
+						s.active = ""
+						s.activeID = ""
+					}
+					close(s.changed)
+					s.changed = make(chan struct{})
+					s.mut.Unlock()
+				})
+			}, operationID, nil
+		}
+		if s.active != "" && s.active != baseID && !s.busy {
+			s.mut.Unlock()
+			return nil, "", errMordeQuotaUnresolvedOperation
+		}
+		if s.active == baseID && !s.busy && s.activeID != operationID {
+			s.activeID = operationID
+			s.mut.Unlock()
+			continue
+		}
+		changed := s.changed
+		s.mut.Unlock()
+		select {
+		case <-ctx.Done():
+			return nil, "", ctx.Err()
+		case <-changed:
+		}
+	}
+}
+
+func mordeQuotaAttemptID(baseID string, attempt uint64) string {
+	if attempt == 0 {
+		return baseID
+	}
+	// Later IDs distinguish fresh attempts after the server confirms rollback.
+	hash := sha256.Sum256([]byte(fmt.Sprintf("%s:%d", baseID, attempt)))
+	return hex.EncodeToString(hash[:])
+}
+
+func mordeQuotaOperationID(folderID string, file protocol.FileInfo, operation string) string {
+	type block struct {
+		Hash string `json:"hash"`
+		Size int    `json:"size"`
+	}
+	blocks := make([]block, len(file.Blocks))
+	for i, value := range file.Blocks {
+		blocks[i] = block{Hash: hex.EncodeToString(value.Hash), Size: value.Size}
+	}
+	value := struct {
+		FolderID    string  `json:"folder_id"`
+		Path        string  `json:"path"`
+		Operation   string  `json:"operation"`
+		Type        int32   `json:"type"`
+		Deleted     bool    `json:"deleted"`
+		Size        int64   `json:"size"`
+		ModifiedS   int64   `json:"modified_s"`
+		ModifiedNs  int32   `json:"modified_ns"`
+		ModifiedBy  uint64  `json:"modified_by"`
+		Version     string  `json:"version"`
+		Permissions uint32  `json:"permissions"`
+		NoPerms     bool    `json:"no_permissions"`
+		Blocks      []block `json:"blocks"`
+	}{
+		FolderID: folderID, Path: file.Name, Operation: operation, Type: int32(file.Type), Deleted: file.Deleted,
+		Size: file.Size, ModifiedS: file.ModifiedS, ModifiedNs: file.ModifiedNs,
+		ModifiedBy: uint64(file.ModifiedBy), Version: file.Version.String(),
+		Permissions: file.Permissions, NoPerms: file.NoPermissions, Blocks: blocks,
+	}
+	encoded, _ := json.Marshal(value)
+	hash := sha256.Sum256(encoded)
+	return hex.EncodeToString(hash[:])
+}
+
+func (c *mordeQuotaClient) reserve(ctx context.Context, file protocol.FileInfo, operation string, size int64, operationID string) (mordeQuotaReservation, error) {
+	if c == nil || c.workspaceID == "" || !validMordeQuotaFolderID(c.folderID) || (operation != "upsert" && operation != "delete") || size < 0 || operation == "delete" && size != 0 {
+		return mordeQuotaReservation{}, errors.New("invalid Morde quota reservation")
+	}
+	value := mordeQuotaRequest{
+		WorkspaceID: c.workspaceID, FolderID: c.folderID, OperationID: operationID,
+		Path: file.Name, Operation: operation, SizeBytes: size,
+	}
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return mordeQuotaReservation{}, fmt.Errorf("encode Morde quota reservation: %w", err)
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://morde/v1/reservations", strings.NewReader(string(encoded)))
+	if err != nil {
+		return mordeQuotaReservation{}, fmt.Errorf("create Morde quota reservation request: %w", err)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	response, err := c.client.Do(request)
+	if err != nil {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError("reserve", err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		body, _ := io.ReadAll(io.LimitReader(response.Body, mordeQuotaResponseLimit))
+		detail := strings.TrimSpace(string(body))
+		err := fmt.Errorf("Morde quota reservation returned HTTP %d", response.StatusCode)
+		if detail != "" {
+			err = fmt.Errorf("%w: %s", err, detail)
+		}
+		if response.StatusCode >= 500 || response.StatusCode == http.StatusRequestTimeout {
+			return mordeQuotaReservation{}, mordeQuotaUnknownError("reserve", err)
+		}
+		return mordeQuotaReservation{}, err
+	}
+	var result mordeQuotaReservation
+	decoder := json.NewDecoder(io.LimitReader(response.Body, mordeQuotaResponseLimit))
+	if err := decoder.Decode(&result); err != nil {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError("decode reservation", err)
+	}
+	if result.ReservationID == "" || !validQuotaRevision(result.BaseRevision) || result.State == "" {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError("validate reservation", errors.New("invalid reservation receipt"))
+	}
+	return result, nil
+}
+
+func validMordeQuotaFolderID(value string) bool {
+	return len(value) == 38 && strings.HasPrefix(value, "morde-") && strings.Trim(value[6:], "0123456789abcdef") == ""
+}
+
+func (c *mordeQuotaClient) settle(ctx context.Context, reservationID string) error {
+	receipt, err := c.receipt(ctx, reservationID, "settle")
+	if err != nil {
+		return err
+	}
+	switch receipt.State {
+	case "settled":
+		return nil
+	case "aborted":
+		return errMordeQuotaAborted
+	default:
+		return mordeQuotaUnknownError("settle", fmt.Errorf("unexpected reservation state %q", receipt.State))
+	}
+}
+
+func (f *sendReceiveFolder) settleMordeQuota(reservationID string) error {
+	if f.mordeQuotaClient == nil {
+		return nil
+	}
+	ctx, cancel := mordeQuotaContext()
+	defer cancel()
+	return f.mordeQuotaClient.settle(ctx, reservationID)
+}
+
+func (c *mordeQuotaClient) abort(ctx context.Context, reservationID string) (mordeQuotaOutcome, error) {
+	receipt, err := c.receipt(ctx, reservationID, "abort")
+	if err != nil {
+		return mordeQuotaUnknown, err
+	}
+	switch receipt.State {
+	case "aborted":
+		return mordeQuotaAbortedOutcome, nil
+	case "settled":
+		return mordeQuotaComplete, nil
+	default:
+		return mordeQuotaUnknown, mordeQuotaUnknownError("abort", fmt.Errorf("unexpected reservation state %q", receipt.State))
+	}
+}
+
+func (c *mordeQuotaClient) receipt(ctx context.Context, reservationID, action string) (mordeQuotaReservation, error) {
+	if c == nil || reservationID == "" || (action != "settle" && action != "abort") {
+		return mordeQuotaReservation{}, errors.New("invalid Morde quota receipt request")
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		"http://morde/v1/reservations/"+url.PathEscape(reservationID)+"/"+action, nil)
+	if err != nil {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError(action, err)
+	}
+	response, err := c.client.Do(request)
+	if err != nil {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError(action, err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, mordeQuotaResponseLimit))
+		return mordeQuotaReservation{}, mordeQuotaUnknownError(action, fmt.Errorf("Morde quota %s returned HTTP %d", action, response.StatusCode))
+	}
+	var result mordeQuotaReservation
+	decoder := json.NewDecoder(io.LimitReader(response.Body, mordeQuotaResponseLimit))
+	if err := decoder.Decode(&result); err != nil {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError(action, err)
+	}
+	if result.ReservationID != reservationID || result.State == "" || !validQuotaRevision(result.BaseRevision) {
+		return mordeQuotaReservation{}, mordeQuotaUnknownError(action, errors.New("invalid reservation receipt"))
+	}
+	return result, nil
+}
+
+func validQuotaRevision(revision json.RawMessage) bool {
+	value := strings.TrimSpace(string(revision))
+	return value != "" && value != "null"
+}
+
+func mordeQuotaUnknownError(action string, cause error) error {
+	return fmt.Errorf("%w: %s: %v", errMordeQuotaResultUnknown, action, cause)
+}
+
+func mordeQuotaContext() (context.Context, context.CancelFunc) {
+	return context.WithTimeout(context.Background(), 10*time.Minute)
+}
diff --git a/lib/mordequota/quota.go b/lib/mordequota/quota.go
new file mode 100644
index 000000000..2d88abb63
--- /dev/null
+++ b/lib/mordequota/quota.go
@@ -0,0 +1,273 @@
+// Package mordequota prototypes admission accounting for one Workspace.
+package mordequota
+
+import (
+	"errors"
+	"io/fs"
+	"strings"
+	"sync"
+)
+
+const (
+	MaxFileBytes      int64 = 300 << 20
+	MaxWorkspaceBytes int64 = 5 << 30
+)
+
+var (
+	ErrInvalidFile         = errors.New("invalid file path or size")
+	ErrFileTooLarge        = errors.New("file exceeds workspace single-file limit")
+	ErrWorkspaceFull       = errors.New("workspace exceeds logical size limit")
+	ErrPathBusy            = errors.New("workspace path already has a reservation")
+	ErrFileNotFound        = errors.New("workspace file does not exist")
+	ErrDestinationExists   = errors.New("workspace rename destination already exists")
+	ErrInvalidRename       = errors.New("workspace rename source and destination must differ")
+	ErrExclusionUnverified = errors.New("workspace exclusion is not verified inaccessible")
+	ErrInvalidReservation  = errors.New("reservation is not active")
+	ErrReservationLimit    = errors.New("reservation ID space exhausted")
+)
+
+// Ledger is a process-local prototype. The caller must supply an authoritative,
+// normalized list of admitted regular files and serialize all writers through
+// one ledger. The ledger does not persist state or protect filesystem writes.
+// shortcut: process-local only; replace with durable shared reservations before production.
+type Ledger struct {
+	mu           sync.Mutex
+	files        map[string]int64
+	byPath       map[string]uint64
+	reservations map[uint64]candidate
+	committed    int64
+	reserved     int64
+	nextID       uint64
+}
+
+type candidate struct {
+	path     string
+	source   string
+	size     int64
+	increase int64
+	remove   bool
+	exclude  bool
+}
+
+// Reservation is valid only for the ledger that issued it and until settled.
+type Reservation struct {
+	ledger *Ledger
+	id     uint64
+}
+
+// Status counts logical file bytes; temporary data and excluded files are not
+// included. ReservedBytes includes pending increases, not pending decreases.
+type Status struct {
+	CommittedBytes int64
+	ReservedBytes  int64
+	Pending        int
+}
+
+// New starts from a verified, complete snapshot of currently admitted files.
+// After restart, reconcile all previously pending filesystem outcomes first.
+func New(files map[string]int64) (*Ledger, error) {
+	l := &Ledger{
+		files:        make(map[string]int64, len(files)),
+		byPath:       make(map[string]uint64),
+		reservations: make(map[uint64]candidate),
+	}
+	for path, size := range files {
+		if err := validateFile(path, size); err != nil {
+			return nil, err
+		}
+		if size > MaxWorkspaceBytes-l.committed {
+			return nil, ErrWorkspaceFull
+		}
+		l.files[path] = size
+		l.committed += size
+	}
+	return l, nil
+}
+
+func validateFile(path string, size int64) error {
+	if !validPath(path) || size < 0 {
+		return ErrInvalidFile
+	}
+	if size > MaxFileBytes {
+		return ErrFileTooLarge
+	}
+	return nil
+}
+
+func validPath(path string) bool {
+	return path != "." && fs.ValidPath(path) && !strings.ContainsAny(path, "\\:\x00")
+}
+
+// ReserveFile reserves a candidate's positive size delta before it is written.
+// Paths must already be normalized and validated by the receiving boundary.
+func (l *Ledger) ReserveFile(path string, size int64) (Reservation, error) {
+	if err := validateFile(path, size); err != nil {
+		return Reservation{}, err
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if _, busy := l.byPath[path]; busy {
+		return Reservation{}, ErrPathBusy
+	}
+	increase := max(int64(0), size-l.files[path])
+	if increase > MaxWorkspaceBytes-l.committed-l.reserved {
+		return Reservation{}, ErrWorkspaceFull
+	}
+	return l.reserve(candidate{path: path, size: size, increase: increase})
+}
+
+// ReserveRemoval blocks competing writes until the caller confirms deletion.
+func (l *Ledger) ReserveRemoval(path string) (Reservation, error) {
+	return l.reserveRetirement(path, false)
+}
+
+// ReserveExclusion keeps the old size charged until CommitExclusion confirms
+// the old copy cannot be read or propagated through the workspace.
+func (l *Ledger) ReserveExclusion(path string) (Reservation, error) {
+	return l.reserveRetirement(path, true)
+}
+
+func (l *Ledger) reserveRetirement(path string, exclude bool) (Reservation, error) {
+	if !validPath(path) {
+		return Reservation{}, ErrInvalidFile
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if _, busy := l.byPath[path]; busy {
+		return Reservation{}, ErrPathBusy
+	}
+	if _, exists := l.files[path]; !exists {
+		return Reservation{}, ErrFileNotFound
+	}
+	return l.reserve(candidate{path: path, remove: true, exclude: exclude})
+}
+
+// ReserveRename reserves both paths without charging for a second copy. The
+// caller must enforce an atomic, non-overwriting rename or equivalent boundary.
+func (l *Ledger) ReserveRename(source, destination string) (Reservation, error) {
+	if !validPath(source) || !validPath(destination) {
+		return Reservation{}, ErrInvalidFile
+	}
+	if source == destination {
+		return Reservation{}, ErrInvalidRename
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if _, busy := l.byPath[source]; busy {
+		return Reservation{}, ErrPathBusy
+	}
+	if _, busy := l.byPath[destination]; busy {
+		return Reservation{}, ErrPathBusy
+	}
+	if _, exists := l.files[source]; !exists {
+		return Reservation{}, ErrFileNotFound
+	}
+	if _, exists := l.files[destination]; exists {
+		return Reservation{}, ErrDestinationExists
+	}
+	return l.reserve(candidate{path: destination, source: source})
+}
+
+// reserve is called only with mu held.
+func (l *Ledger) reserve(c candidate) (Reservation, error) {
+	if l.nextID == ^uint64(0) {
+		return Reservation{}, ErrReservationLimit
+	}
+	l.nextID++
+	l.byPath[c.path] = l.nextID
+	if c.source != "" {
+		l.byPath[c.source] = l.nextID
+	}
+	l.reservations[l.nextID] = c
+	l.reserved += c.increase
+	return Reservation{ledger: l, id: l.nextID}, nil
+}
+
+// Commit must be called only after the corresponding filesystem operation has
+// been durably confirmed. A failed write or rename must not call Commit.
+func (l *Ledger) Commit(r Reservation) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	c, ok := l.pending(r)
+	if !ok {
+		return ErrInvalidReservation
+	}
+	if c.exclude {
+		return ErrExclusionUnverified
+	}
+	switch {
+	case c.source != "":
+		l.files[c.path] = l.files[c.source]
+		delete(l.files, c.source)
+	case c.remove:
+		l.committed -= l.files[c.path]
+		delete(l.files, c.path)
+	default:
+		l.committed -= l.files[c.path]
+		l.files[c.path] = c.size
+		l.committed += c.size
+	}
+	l.finish(r.id, c)
+	return nil
+}
+
+// CommitExclusion requires a durable barrier to have made the old copy
+// inaccessible and to remain effective afterward. This in-memory prototype
+// cannot itself prove that a real filesystem or node honors the barrier.
+func (l *Ledger) CommitExclusion(r Reservation) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	c, ok := l.pending(r)
+	if !ok || !c.exclude {
+		return ErrInvalidReservation
+	}
+	l.committed -= l.files[c.path]
+	delete(l.files, c.path)
+	l.finish(r.id, c)
+	return nil
+}
+
+// Cancel releases a reservation only when no corresponding filesystem change
+// occurred. Unknown outcomes must be reconciled before releasing the quota.
+func (l *Ledger) Cancel(r Reservation) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	c, ok := l.pending(r)
+	if !ok {
+		return ErrInvalidReservation
+	}
+	l.finish(r.id, c)
+	return nil
+}
+
+func (l *Ledger) pending(r Reservation) (candidate, bool) {
+	if r.ledger != l || r.id == 0 {
+		return candidate{}, false
+	}
+	c, ok := l.reservations[r.id]
+	return c, ok
+}
+
+func (l *Ledger) finish(id uint64, c candidate) {
+	delete(l.reservations, id)
+	delete(l.byPath, c.path)
+	if c.source != "" {
+		delete(l.byPath, c.source)
+	}
+	l.reserved -= c.increase
+}
+
+// Status returns a consistent accounting snapshot.
+func (l *Ledger) Status() Status {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return Status{CommittedBytes: l.committed, ReservedBytes: l.reserved, Pending: len(l.reservations)}
+}
+
+// FileSize reports the last committed size, not an in-flight candidate.
+func (l *Ledger) FileSize(path string) (int64, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	size, ok := l.files[path]
+	return size, ok
+}
