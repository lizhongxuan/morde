+var errMordeSymlinkExcluded = errors.New("symlink unavailable: excluded by Morde Workspace policy")
+
+// MordeFileTooLarge reports whether any known device has an excluded version.
+func (m *model) MordeFileTooLarge(folder, name string) (bool, error) {
+	m.mut.RLock()
+	cfg, ok := m.folderCfgs[folder]
+	m.mut.RUnlock()
+	if !ok {
+		cfg, ok = m.cfg.Folder(folder)
+		if !ok {
+			return false, ErrFolderMissing
+		}
+	}
+	if cfg.MordeMaxSingleFileBytes > 0 {
+		canonical, err := fs.Canonicalize(name)
+		if err != nil {
+			return false, err
+		}
+		name = canonical
+		filesystem := cfg.Filesystem()
+		if err := osutil.TraversesSymlink(filesystem, filepath.Dir(name)); err != nil {
+			return false, err
+		}
+		info, err := filesystem.Lstat(name)
+		if err != nil && !fs.IsNotExist(err) {
+			return false, err
+		}
+		if err == nil && info.IsRegular() && info.Size() > cfg.MordeMaxSingleFileBytes {
+			return true, nil
+		}
+	}
+	return m.mordeFileTooLarge(folder, name, cfg.MordeMaxSingleFileBytes)
+}
+
+// MordeFileLimitExcluded reports distinct excluded paths known to this node.
+func (m *model) MordeFileLimitExcluded(folder string) (int, error) {
+	m.mut.RLock()
+	cfg, ok := m.folderCfgs[folder]
+	m.mut.RUnlock()
+	if !ok {
+		cfg, ok = m.cfg.Folder(folder)
+		if !ok {
+			return 0, ErrFolderMissing
+		}
+	}
+	if cfg.MordeMaxSingleFileBytes <= 0 {
+		return 0, nil
+	}
+	devices, err := m.sdb.ListDevicesForFolder(folder)
+	if err != nil {
+		return 0, err
+	}
+	devices = append(devices, protocol.LocalDeviceID)
+	paths := make(map[string]struct{})
+	for _, device := range devices {
+		files, result := m.sdb.AllLocalFiles(folder, device)
+		for file := range files {
+			if !file.IsDeleted() && file.Type == protocol.FileInfoTypeFile && file.Size > cfg.MordeMaxSingleFileBytes {
+				paths[file.Name] = struct{}{}
+			}
+		}
+		if err := result(); err != nil {
+			return 0, err
+		}
+	}
+	return len(paths), nil
+}
+
+func (m *model) mordeFileTooLarge(folder, name string, maxBytes int64) (bool, error) {
+	if maxBytes <= 0 {
+		return false, nil
+	}
+	devices, err := m.sdb.ListDevicesForFolder(folder)
+	if err != nil {
+		return false, err
+	}
+	devices = append(devices, protocol.LocalDeviceID)
+	for _, device := range devices {
+		file, ok, err := m.sdb.GetDeviceFile(folder, device, name)
+		if err != nil {
+			return false, err
+		}
+		if ok && !file.IsDeleted() && file.Type == protocol.FileInfoTypeFile && file.Size > maxBytes {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func (f *sendReceiveFolder) mordeFileBlocked(name string) (bool, error) {
+	maxBytes := f.MordeMaxSingleFileBytes
+	if maxBytes <= 0 {
+		return false, nil
+	}
+	blocked, err := f.model.mordeFileTooLarge(f.folderID, name, maxBytes)
+	if err != nil || blocked {
+		return blocked, err
+	}
+	info, err := f.mtimefs.Lstat(name)
+	if fs.IsNotExist(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	return info.IsRegular() && info.Size() > maxBytes, nil
+}
+
+func (f *sendReceiveFolder) mordeManaged() bool {
+	return f.MordeMaxSingleFileBytes > 0 || f.mordeQuotaClient != nil
+}
+
+// mordePreserveFile keeps open writers attached to a recoverable inode outside every sync root.
+func (f *sendReceiveFolder) mordePreserveFile(name string) (string, error) {
+	if f.mtimefs.Type() != fs.FilesystemTypeBasic {
+		return "", errors.New("Morde safe replacement requires a basic filesystem")
+	}
+	if err := osutil.TraversesSymlink(f.mtimefs, filepath.Dir(name)); err != nil {
+		return "", err
+	}
+	info, err := f.mtimefs.Lstat(name)
+	if err != nil {
+		return "", err
+	}
+	if !info.IsRegular() && !info.IsSymlink() && !info.IsDir() {
+		return "", errors.New("Morde safe replacement does not support this local item type")
+	}
+	canonical, err := fs.Canonicalize(name)
+	if err != nil {
+		return "", errors.New("Morde safe replacement path is invalid")
+	}
+	relative := filepath.Clean(filepath.FromSlash(canonical))
+	if filepath.IsAbs(relative) || relative == "." || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return "", errors.New("Morde safe replacement path is invalid")
+	}
+	preserveRoot, err := f.mordePreservationRoot()
+	if err != nil {
+		return "", err
+	}
+	folderKey := fmt.Sprintf("%x", sha256.Sum256([]byte(f.folderID)))
+	folderDir := filepath.Join(preserveRoot, folderKey)
+	if err := mkdirPrivate(folderDir); err != nil {
+		return "", fmt.Errorf("create preservation directory: %w", err)
+	}
+	entryID := rand.String(20)
+	backupDir := filepath.Join(folderDir, entryID)
+	if err := os.Mkdir(backupDir, 0o700); err != nil {
+		return "", fmt.Errorf("create preservation entry: %w", err)
+	}
+	metadataPath := filepath.Join(folderDir, entryID+".morde.json")
+	metadata, err := json.Marshal(struct {
+		Version   int       `json:"version"`
+		EntryID   string    `json:"entry_id"`
+		FolderID  string    `json:"folder_id"`
+		Path      string    `json:"path"`
+		CreatedAt time.Time `json:"created_at"`
+	}{1, entryID, f.folderID, filepath.ToSlash(canonical), time.Now().UTC()})
+	if err != nil {
+		_ = os.RemoveAll(backupDir)
+		return "", fmt.Errorf("encode preservation metadata: %w", err)
+	}
+	metadataFile, err := os.OpenFile(metadataPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		_ = os.RemoveAll(backupDir)
+		return "", fmt.Errorf("create preservation metadata: %w", err)
+	}
+	_, err = metadataFile.Write(metadata)
+	if err == nil {
+		err = metadataFile.Sync()
+	}
+	if closeErr := metadataFile.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		_ = os.Remove(metadataPath)
+		_ = os.RemoveAll(backupDir)
+		return "", fmt.Errorf("write preservation metadata: %w", err)
+	}
+	backup := filepath.Join(backupDir, relative)
+	if err := os.MkdirAll(filepath.Dir(backup), 0o700); err != nil {
+		_ = os.Remove(metadataPath)
+		_ = os.RemoveAll(backupDir)
+		return "", fmt.Errorf("create preserved path: %w", err)
+	}
+	root := f.mtimefs.URI()
+	if err := f.inWritableDir(func(path string) error { return os.Rename(filepath.Join(root, path), backup) }, name); err != nil {
+		_ = os.Remove(metadataPath)
+		_ = os.RemoveAll(backupDir)
+		return "", fmt.Errorf("preserve old file: %w", err)
+	}
+	return backup, nil
+}
+
+func (f *sendReceiveFolder) mordePreservationRoot() (string, error) {
+	root, err := filepath.EvalSymlinks(f.mtimefs.URI())
+	if err != nil {
+		return "", fmt.Errorf("resolve Workspace root before preserving file: %w", err)
+	}
+	root, err = filepath.Abs(root)
+	if err != nil {
+		return "", fmt.Errorf("resolve Workspace path before preserving file: %w", err)
+	}
+	preserveRoot := filepath.Join(filepath.Dir(root), ".morde-preserved")
+	for _, folder := range f.model.cfg.FolderList() {
+		if folder.Filesystem().Type() != fs.FilesystemTypeBasic {
+			continue
+		}
+		otherRoot, err := filepath.Abs(folder.Filesystem().URI())
+		if err != nil {
+			return "", fmt.Errorf("resolve configured sync root: %w", err)
+		}
+		otherRoot, err = resolvePathWithMissingTail(otherRoot)
+		if err != nil {
+			return "", fmt.Errorf("resolve configured sync root: %w", err)
+		}
+		if pathsOverlap(preserveRoot, otherRoot) {
+			return "", errors.New("Morde preservation directory overlaps a configured sync root")
+		}
+	}
+	if err := mkdirPrivate(preserveRoot); err != nil {
+		return "", fmt.Errorf("create Morde preservation root: %w", err)
+	}
+	resolvedPreserveRoot, err := filepath.EvalSymlinks(preserveRoot)
+	if err != nil {
+		return "", fmt.Errorf("resolve Morde preservation root: %w", err)
+	}
+	for _, folder := range f.model.cfg.FolderList() {
+		if folder.Filesystem().Type() != fs.FilesystemTypeBasic {
+			continue
+		}
+		otherRoot, err := filepath.Abs(folder.Filesystem().URI())
+		if err != nil {
+			return "", fmt.Errorf("resolve configured sync root: %w", err)
+		}
+		otherRoot, err = resolvePathWithMissingTail(otherRoot)
+		if err != nil {
+			return "", fmt.Errorf("resolve configured sync root: %w", err)
+		}
+		if pathsOverlap(resolvedPreserveRoot, otherRoot) {
+			return "", errors.New("Morde preservation directory overlaps a configured sync root")
+		}
+	}
+	return resolvedPreserveRoot, nil
+}
+
+func resolvePathWithMissingTail(path string) (string, error) {
+	path, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	current := filepath.Clean(path)
+	var missing []string
+	for {
+		resolved, err := filepath.EvalSymlinks(current)
+		if err == nil {
+			for i := len(missing) - 1; i >= 0; i-- {
+				resolved = filepath.Join(resolved, missing[i])
+			}
+			return filepath.Clean(resolved), nil
+		}
+		if !errors.Is(err, os.ErrNotExist) {
+			return "", err
+		}
+		if _, lstatErr := os.Lstat(current); lstatErr == nil {
+			return "", fmt.Errorf("unresolved symlink in configured sync root: %w", err)
+		} else if !errors.Is(lstatErr, os.ErrNotExist) {
+			return "", lstatErr
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			return "", err
+		}
+		missing = append(missing, filepath.Base(current))
+		current = parent
+	}
+}
+
+func mkdirPrivate(path string) error {
+	if err := os.Mkdir(path, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+		return err
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0o077 != 0 {
+		return errors.New("Morde preservation path is not a private directory")
+	}
+	return nil
+}
+
+func pathsOverlap(a, b string) bool {
+	if pathContains(a, b) || pathContains(b, a) {
+		return true
+	}
+	if runtime.GOOS == "darwin" || runtime.GOOS == "windows" {
+		return pathContainsFilesystem(a, b) || pathContainsFilesystem(b, a)
+	}
+	return false
+}
+
+func pathContainsFilesystem(root, candidate string) bool {
+	root, candidate = filepath.Clean(root), filepath.Clean(candidate)
+	rootVolume, candidateVolume := filepath.VolumeName(root), filepath.VolumeName(candidate)
+	if !filesystemPathComponentEqual(rootVolume, candidateVolume) {
+		return false
+	}
+	rootParts := filepathComponents(strings.TrimPrefix(root, rootVolume))
+	candidateParts := filepathComponents(strings.TrimPrefix(candidate, candidateVolume))
+	if len(rootParts) > len(candidateParts) {
+		return false
+	}
+	for i := range rootParts {
+		if !filesystemPathComponentEqual(rootParts[i], candidateParts[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func filepathComponents(path string) []string {
+	var components []string
+	for _, component := range strings.Split(path, string(filepath.Separator)) {
+		if component != "" && component != "." {
+			components = append(components, component)
+		}
+	}
+	return components
+}
+
+func filesystemPathComponentEqual(a, b string) bool {
+	if runtime.GOOS == "darwin" {
+		a, b = norm.NFD.String(a), norm.NFD.String(b)
+	}
+	return strings.EqualFold(a, b)
+}
+
+func pathContains(root, candidate string) bool {
+	rel, err := filepath.Rel(root, candidate)
+	if err != nil {
+		return false
+	}
+	return rel == "." || rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+}
+
+// mordeInstallWithoutReplace cannot overwrite a file created concurrently.
+func (f *sendReceiveFolder) mordeInstallWithoutReplace(name, temp string) error {
+	if f.mtimefs.Type() != fs.FilesystemTypeBasic {
+		return errors.New("Morde safe replacement requires a basic filesystem")
+	}
+	if err := osutil.TraversesSymlink(f.mtimefs, filepath.Dir(name)); err != nil {
+		return err
+	}
+	if err := osutil.TraversesSymlink(f.mtimefs, filepath.Dir(temp)); err != nil {
+		return err
+	}
+	info, err := f.mtimefs.Lstat(temp)
+	if err != nil || !info.IsRegular() {
+		return errors.New("Morde replacement temporary file is not a regular file")
+	}
+	if f.MordeMaxSingleFileBytes > 0 && info.Size() > f.MordeMaxSingleFileBytes {
+		return errMordeFileTooLarge
+	}
+	root := f.mtimefs.URI()
+	if err := f.inWritableDir(func(string) error {
+		return os.Link(filepath.Join(root, temp), filepath.Join(root, name))
+	}, name); err != nil {
+		return err
+	}
+	if err := f.mtimefs.Remove(temp); err != nil {
+		f.sl.Debug("Could not remove linked Morde replacement temporary file", "error", err)
+	}
+	return nil
+}
+
+// mordePreserveAndInstall retains the old inode before replacing a managed file.
+func (f *sendReceiveFolder) mordePreserveAndInstall(name, temp string) error {
+	if f.mtimefs.Type() != fs.FilesystemTypeBasic {
+		return errors.New("Morde safe replacement requires a basic filesystem")
+	}
+	if err := osutil.TraversesSymlink(f.mtimefs, filepath.Dir(temp)); err != nil {
+		return err
+	}
+	info, err := f.mtimefs.Lstat(temp)
+	if err != nil || !info.IsRegular() || f.MordeMaxSingleFileBytes > 0 && info.Size() > f.MordeMaxSingleFileBytes {
+		return errors.New("Morde replacement temporary file is invalid or too large")
+	}
+	root := f.mtimefs.URI()
+	probe := filepath.Join(root, filepath.Dir(name), ".morde-link-probe-"+rand.String(20))
+	if err := os.Link(filepath.Join(root, temp), probe); err != nil {
+		return fmt.Errorf("Morde safe replacement requires same-filesystem hard links: %w", err)
+	}
+	if err := os.Remove(probe); err != nil {
+		return fmt.Errorf("remove hard-link probe: %w", err)
+	}
+	backup, err := f.mordePreserveFile(name)
+	if err != nil {
+		return err
+	}
+	if err := f.mordeInstallWithoutReplace(name, temp); err != nil {
+		// An existing target must win; the preserved file remains recoverable.
+		_ = os.Link(backup, filepath.Join(root, name))
+		return fmt.Errorf("install replacement; previous file retained at %s: %w", backup, err)
+	}
+	return nil
+}
