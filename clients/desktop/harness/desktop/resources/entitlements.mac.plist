<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened-runtime entitlements for a Developer ID build (scripts/desktop-app/package-mac.sh
     applies them to the app, its helpers and the bundled Python runtime when a certificate is in
     the environment). Electron needs JIT and unsigned executable memory; the PyInstaller runtime
     loads libraries that are not Apple's; the hands drive other apps through Apple events. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
