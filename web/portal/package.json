{
  "name": "@morde/portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "predev": "msw init public --save",
    "build": "tsc -b && vite build && npm --prefix ../../project/nanoMuse/web run build && node scripts/copy-morde-mobile.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "test": "vitest run && node --test scripts/copy-morde-mobile.node-test.mjs",
    "test:watch": "vitest",
    "test:release": "node --test scripts/validate-desktop-release.node-test.mjs",
    "validate:desktop-release": "node scripts/validate-desktop-release.mjs",
    "generate:api": "openapi-typescript ../../server/openapi/portal.yaml -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
