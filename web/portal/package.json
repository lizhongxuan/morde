{
  "name": "@morde/portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "predev": "msw init public --save",
    "build": "npm run build:pc && npm run build:admin",
    "build:pc": "tsc -b && vite build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts vite.admin.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:outbox-browser": "node --test scripts/message-outbox-concurrency.node-test.mjs",
    "test:watch": "vitest",
    "test:release": "node --test scripts/validate-desktop-release.node-test.mjs",
    "validate:desktop-release": "node scripts/validate-desktop-release.mjs",
    "generate:api": "openapi-typescript ../../server/openapi/portal.yaml -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "mermaid": "11.17.2",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
